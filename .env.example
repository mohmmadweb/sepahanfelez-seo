# ─────────────────────────────────────────────────────────────────────────────
#  سپاهان فلز — همه‌ی کلیدها و دسترسی‌ها فقط اینجا
#  این فایل الگوست (بدون مقدار) و در گیت هست. مقدارهای واقعی در `.env` کنار همین
#  فایل‌اند که در گیت نیست و فقط صاحب سرور می‌تواند بخواندش (chmod 600).
#  کد هیچ‌جا مقدار را نمی‌نویسد؛ فقط نام متغیر را صدا می‌زند.
# ─────────────────────────────────────────────────────────────────────────────

# ── داشبورد sepahanfelezseo.lenzit.ir ─────────────────────────────────────────
# رمز ورود به داشبورد. عوضش کنید و منتظر بیلد بعدی بمانید (یا: run_daily.py --only build publish)
SF_DASHBOARD_PASSWORD=
# نشانی عمومی داشبورد (برای بازگشت ورود لینکدین)
PUBLIC_BASE_URL=https://sepahanfelezseo.lenzit.ir
# توکن تونل Cloudflare (Zero Trust → Networks → Tunnels → sepahanfelez-seo → توکن). ذخیره‌اش تونل را خودکار راه می‌اندازد.
CLOUDFLARE_TUNNEL_TOKEN=
# کلید رمزگذاری پشتیبان داده‌ها و داده‌ی گوگل (همین مقدار باید در GitHub Secret هم باشد)
SF_STATE_KEY=

# ── گوگل (Search Console، Analytics، PageSpeed) ─────────────────────────────
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_API_KEY=
GSC_PROPERTY=sc-domain:sepahanfelez.ir
GA4_PROPERTY_ID=

# ── گوگل درایو (عکس محصولات، دسته‌ها، کارخانه) — با حساب سرویس؛ پوشه را با ایمیل آن Viewer به اشتراک بگذارید ──────────────────────────
# پشتیبان‌ها
RCLONE_REMOTE=gdrive:
# عکس محصولات: درایو mohmmadweb@gmail.com (از صفحه‌ی اتصالات وصل می‌شود)
DRIVE_PHOTOS_REMOTE=gdrive-sf:
DRIVE_ROOT_FOLDER_ID=
DRIVE_LOGO_FOLDER_ID=
DRIVE_PRODUCTS_FOLDER_ID=

# حساب‌ها (شماره، نام کاربری، رمز اینستاگرام…) از صفحه‌ی «اتصالات و تنظیمات» اضافه می‌شوند و همین‌جا با نام SF_ACCT_* ذخیره می‌شوند.

# ── تلگرام ───────────────────────────────────────────────────────────────────
# حساب کاربری (مدیریت کانال، آمار، استوری کانال): از my.telegram.org → API development tools
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# ربات انتشار و گزارش (از @BotFather) — ادمین کانال با دسترسی Post Messages
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL=
# چتی که تأیید محتوا و گزارش روزانه به آن می‌رود (آیدی عددی شما)
TELEGRAM_ADMIN_CHAT_ID=

# ── بله ──────────────────────────────────────────────────────────────────────
BALE_BOT_TOKEN=
BALE_CHANNEL=

# ── ایتا ─────────────────────────────────────────────────────────────────────
EITAAYAR_TOKEN=
EITAA_CHANNEL=

# ── روبیکا ───────────────────────────────────────────────────────────────────
RUBIKA_BOT_TOKEN=
RUBIKA_CHANNEL=

# ── اینستاگرام ───────────────────────────────────────────────────────────────
# انتشار رسمی (Graph API): اپ Meta + حساب Business متصل به صفحه‌ی فیسبوک
META_APP_ID=
META_APP_SECRET=
IG_BUSINESS_ACCOUNT_ID=
IG_GRAPH_TOKEN=

# ── لینکدین ─────────────────────────────────────────────────────────────────
# اپ در developer.linkedin.com (محصولات: Sign In with LinkedIn using OpenID Connect + Share on LinkedIn).
# Redirect URL اپ: https://sepahanfelezseo.lenzit.ir/api/linkedin/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# اختیاری: شناسه‌ی عددی صفحه‌ی شرکت (برای انتشار به نام شرکت؛ نیاز به تأیید Community Management API)
LINKEDIN_ORG_ID=

# ── مقاله‌های سایت (از راه پنل مدیریت sepahanfelez.ir) ───────────────────────
# شماره‌ی موبایل مدیر سایت: کد ورود پنل به آن پیامک می‌شود
SITE_ADMIN_MOBILE=
# 1 = پیش‌نویسی که کنترل کیفیت را رد نشده در زمان برنامه خودکار منتشر شود؛ 0 = فقط بعد از تأیید شما
SITE_AUTOPUBLISH=0
# 1 = استوری‌ها و پست‌های کانال که کنترل کیفیت را رد نشده‌اند سر ساعت خودکار منتشر شوند؛ 0 = بعد از تأیید شما
SOCIAL_AUTOPUBLISH=0
# شماره‌های تماس شرکت که مقاله‌ها مجازند بنویسند (با ویرگول)
SITE_CONTACT_PHONES=

# ── ابزارهای اختیاری ─────────────────────────────────────────────────────────
SERPER_API_KEY=
BING_WEBMASTER_API_KEY=
CLARITY_PROJECT_ID=
# خالی = نوشتن متن با Claude Code روی همین سرور (بدون هزینه‌ی API)
ANTHROPIC_API_KEY=

# گیرنده‌ی هشدار قطعی/خطای انتشار از راه ربات @sepahanfelezbot (شماره باید یک بار در ربات وارد شده باشد)
SF_ALERT_MOBILE=
SOCIAL_STORY_NETS=
SOCIAL_CHANNEL_NETS=
